{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Content Studio",
  "version": "1.0.0",
  "identifier": "com.contentstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**/*"
          ]
        }
      },
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src 'self' http://127.0.0.1:8787; media-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Content Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:content-studio.db"
      ]
    }
  }
}
